@model HAMSPatient.Models.DoctorSearchViewModel
@{
    ViewData["Title"] = "Tra cứu Bác sĩ & Đặt Lịch Khám";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-primary"><i class="bi bi-calendar-check me-2"></i>HAMS - Đặt Lịch Khám Bệnh Trực Tuyến</h2>
            <p class="text-muted">Chọn bác sĩ, kiểm tra lưu lượng ca khám (Morning / Afternoon Shift Capacity) và chọn khung giờ phù hợp.</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4 bg-light p-3 rounded-3">
        <div class="card-body">
            <form asp-action="Search" method="get" class="row align-items-end g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Chuyên khoa</label>
                    <select name="departmentId" class="form-select">
                        <option value="">-- Tất cả chuyên khoa --</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id" selected="@(Model.SelectedDepartmentId == dept.Id)">@dept.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Ngày khám</label>
                    <input type="date" name="date" class="form-control" value="@Model.TargetDate?.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Tên bác sĩ / Chuyên môn</label>
                    <input type="text" name="term" class="form-control" value="@Model.SearchTerm" placeholder="Nhập tên bác sĩ..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold"><i class="bi bi-search me-1"></i> Tra cứu</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        @if (!Model.DoctorCards.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted mb-3 fs-5">Không tìm thấy bác sĩ phù hợp với tiêu chí tìm kiếm.</div>
                <a asp-action="Search" class="btn btn-outline-primary"><i class="bi bi-arrow-clockwise me-1"></i> Xóa bộ lọc</a>
            </div>
        }
        else
        {
            @foreach (var doc in Model.DoctorCards)
            {
                <div class="col-lg-6">
                    <div class="card h-100 border-1 shadow-sm rounded-3">
                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1">@doc.DepartmentName</span>
                                        <h5 class="fw-bold mb-0">@doc.AcademicTitle @doc.FullName</h5>
                                        <small class="text-muted">Phòng khám: <strong>Phòng @doc.RoomNumber</strong></small>
                                    </div>
                                    <div class="text-end">
                                        <span class="text-danger fw-bold fs-5">@doc.PricePerSlot.ToString("N0") VNĐ</span>
                                    </div>
                                </div>
                                <hr class="opacity-25" />

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 border rounded bg-white small">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-semibold">Ca Sáng (08:00 - 12:00)</span>
                                                <span class="badge @doc.MorningCapacity.BadgeClass">@doc.MorningCapacity.LoadPercentage%</span>
                                            </div>
                                            <small class="text-muted mt-1 d-block">Còn trống: <strong>@doc.MorningCapacity.AvailableSlots</strong> / @doc.MorningCapacity.TotalSlots slot</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded bg-white small">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-semibold">Ca Chiều (13:00 - 17:00)</span>
                                                <span class="badge @doc.AfternoonCapacity.BadgeClass">@doc.AfternoonCapacity.LoadPercentage%</span>
                                            </div>
                                            <small class="text-muted mt-1 d-block">Còn trống: <strong>@doc.AfternoonCapacity.AvailableSlots</strong> / @doc.AfternoonCapacity.TotalSlots slot</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <a asp-action="SelectSlot" asp-route-doctorId="@doc.DoctorId" asp-route-date="@Model.TargetDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-primary w-100 fw-semibold mt-2">
                                <i class="bi bi-clock me-1"></i> Chọn Khung Giờ Khám & Đặt Lịch
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
